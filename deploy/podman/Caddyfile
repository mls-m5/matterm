# Reverse proxy in front of matterm-server. It is the only container with a
# published port and the only one that can reach the outside network.
# This file is for the laptop: plain HTTP on loopback (localhost is a secure
# context in browsers). See compose.server.yaml for the public variant.
{
	admin off
	auto_https off
}

:8080 {
	encode off
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# WebSocket upgrades are proxied transparently.
	reverse_proxy matterm:8080
}
