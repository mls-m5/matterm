# Site for the host's existing nginx on the public server. Terminates TLS and
# forwards to the matterm container, which compose.server.yaml publishes on
# 127.0.0.1:8081 only. Adjust names and certificate paths.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Independent per-client defence in front of the server's own limiter.
# Configure trusted_proxy for this peer; nginx overwrites X-Forwarded-For
# with exactly $remote_addr, so trusted_proxy_hops is 0 (not 1).
limit_req_zone $binary_remote_addr zone=matterm_login:1m rate=6r/m;

# Requests for any other name (or a bare IP) never reach the server.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name term.example.org;

    ssl_certificate     /etc/letsencrypt/live/term.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/term.example.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    client_header_timeout 10s;
    client_body_timeout 10s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    server_tokens off;
    client_max_body_size 16k;

    location = /login {
        limit_req zone=matterm_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;   # do not trust clients
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
