# matterm-server image. PROVISIONAL: the server arrives in phase 2 of
# docs/WEB_TERMINAL.md; the CMake options and target below do not exist yet.
#
#   podman build -f deploy/podman/Containerfile -t matterm-server .

FROM docker.io/library/debian:bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates \
        libboost-dev libboost-system-dev libsodium-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# lib/fast-json is a git submodule: run `git submodule update --init` first.
COPY . .
# The server must not need SDL2, fonts, or Fontconfig (phase 2 makes the
# root CMakeLists.txt skip them when only the server is built).
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DMATTERM_BUILD_SERVER=ON -DMATTERM_BUILD_APP=OFF \
        -DMATTERM_BUILD_DEMO=OFF -DBUILD_TESTING=OFF \
 && cmake --build /build --target matterm-server \
 && install -D /build/matterm-server /out/usr/local/bin/matterm-server

FROM docker.io/library/debian:bookworm-slim
# bash and coreutils are the "program" the web terminal runs. Keep this image
# small: whatever is installed here is what a logged-in user can use.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libsodium23 libboost-system1.74.0 bash coreutils \
        less nano ncurses-term \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home --shell /bin/bash matterm
COPY --from=build /out/ /
COPY web/ /usr/share/matterm/web/
USER matterm
WORKDIR /home/matterm
ENV HOME=/home/matterm LANG=C.UTF-8
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/matterm-server"]
