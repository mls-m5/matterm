# nginx in front of chatd: TLS, WebSocket upgrade, limits. An example to adapt,
# not a tested file. chatd itself listens on plain WebSocket and trusts
# X-Forwarded-For only from the address given to --trust-proxy.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

limit_conn_zone $binary_remote_addr zone=chat_conn:10m;
limit_req_zone  $binary_remote_addr zone=chat_req:10m rate=5r/s;

server {
    listen 443 ssl http2;
    server_name chat.example.org;

    ssl_certificate     /etc/letsencrypt/live/chat.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.org/privkey.pem;

    # Only the WebSocket path exists; anything else is refused.
    location / {
        limit_conn chat_conn 4;
        limit_req  zone=chat_req burst=10 nodelay;
        client_max_body_size 1k;

        proxy_pass http://127.0.0.1:8097;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        # The Origin header goes through untouched; chatd checks it.
        # Replace, never append: a client-supplied X-Forwarded-For is not ours.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
    }

    # Keep the access log short-lived or off: visitor IPs live there.
    access_log off;
}
