# nginx in front of chatd: TLS, WebSocket upgrade, limits. An example to adapt,
# not a tested file. chatd itself listens on plain WebSocket and trusts
# X-Forwarded-For only from the address given to --trust-proxy.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

limit_conn_zone $binary_remote_addr zone=chat_conn:10m;
limit_req_zone  $binary_remote_addr zone=chat_req:10m rate=5r/s;

server {
    listen 443 ssl http2;
    server_name xn--laserskld-67a.se;

    ssl_protocols TLSv1.2 TLSv1.3;
    # chatd's own 5 s handshake deadline starts only after nginx has read the request.
    client_header_timeout 10s;
    client_body_timeout   10s;

    ssl_certificate     /etc/letsencrypt/live/xn--laserskld-67a.se/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xn--laserskld-67a.se/privkey.pem;

    # Only /matterm is the chat (the demo's default address); chatd itself wants /; everything else is a plain 404 here.
    location / {
        return 404;
    }

    location = /matterm {
        # Per address. Several people behind one NAT (an office, a campus) share
        # it, and chatd's own cap is 3 per source; pick the number knowingly.
        # IPv6: $binary_remote_addr is per /128 while chatd counts per /64.
        limit_conn chat_conn 4;
        limit_req  zone=chat_req burst=10 nodelay;
        client_max_body_size 1k;

        proxy_pass http://127.0.0.1:8097/; # the URI "/" replaces /matterm
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        # The Origin header goes through untouched; chatd checks it.
        # Replace, never append: a client-supplied X-Forwarded-For is not ours.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
    }

    # Keep the access log short-lived or off: visitor IPs live there. The error
    # log also names client addresses for refused requests; for none at all use
    # `error_log /var/log/nginx/error.log crit;` (and limit_req_log_level crit).
    access_log off;
}
