# Counts the repository for the demo's `about` command and writes them as a
# header (run with -DROOT=<source dir> -DOUT=<header>; used as a build step, so
# the numbers always match the files that were built). Lines are newline
# characters. Third-party code (lib/, matperf/, test/mls-unit-test, node_modules)
# is not counted.
function(count_lines files out_lines out_files)
    set(total 0)
    set(n 0)
    foreach(f ${files})
        file(READ "${f}" content)
        string(REGEX REPLACE "[^\n]" "" newlines "${content}")
        string(LENGTH "${newlines}" lines)
        math(EXPR total "${total} + ${lines}")
        math(EXPR n "${n} + 1")
    endforeach()
    set(${out_lines} ${total} PARENT_SCOPE)
    set(${out_files} ${n} PARENT_SCOPE)
endfunction()

# C++ of the library, applications, demo, benchmarks and the web client's C++.
file(GLOB_RECURSE cpp_files "${ROOT}/src/*.cpp" "${ROOT}/src/*.h" "${ROOT}/app/*.cpp"
    "${ROOT}/app/*.h" "${ROOT}/demo/*.cpp" "${ROOT}/demo/*.h" "${ROOT}/bench/*.cpp"
    "${ROOT}/bench/*.h")
file(GLOB web_cpp "${ROOT}/web/*.cpp" "${ROOT}/web/*.h")
list(APPEND cpp_files ${web_cpp})
count_lines("${cpp_files}" cpp_lines cpp_count)

# The browser client's JavaScript, HTML and CSS, and its browser test scripts.
file(GLOB web_files "${ROOT}/web/*.js" "${ROOT}/web/*.html" "${ROOT}/web/*.css"
    "${ROOT}/web/tools/*.js")
count_lines("${web_files}" web_lines web_count)

# Tests: sources, helpers and scripts (not the unit-test framework).
file(GLOB test_files "${ROOT}/test/*.cpp" "${ROOT}/test/*.h" "${ROOT}/test/*.py"
    "${ROOT}/test/*.cmake")
count_lines("${test_files}" test_lines test_count)
set(cases 0)
file(GLOB test_sources "${ROOT}/test/*.cpp")
foreach(f ${test_sources})
    file(READ "${f}" content)
    string(REGEX MATCHALL "TEST_CASE\\(" found "${content}")
    list(LENGTH found n)
    math(EXPR cases "${cases} + ${n}")
endforeach()

# Documents: the notes in docs/ and the top-level ones.
file(GLOB doc_files "${ROOT}/docs/*.md" "${ROOT}/*.md")
count_lines("${doc_files}" doc_lines doc_count)

# The pretend system itself (this demo).
file(GLOB demo_files "${ROOT}/src/fakeos/*.cpp" "${ROOT}/src/fakeos/*.h" "${ROOT}/app/demo/*.cpp"
    "${ROOT}/app/demo/*.h")
count_lines("${demo_files}" demo_lines demo_count)

set(header "// Generated by cmake/AboutStats.cmake. Do not edit.\n#pragma once\n\nnamespace fakeos {\nstruct AboutStats {\n    long cppFiles, cppLines;\n    long webFiles, webLines;\n    long testFiles, testCases, testLines;\n    long docFiles, docLines;\n    long demoFiles, demoLines;\n};\nconstexpr AboutStats kAboutStats = {${cpp_count}, ${cpp_lines}, ${web_count}, ${web_lines},\n                                    ${test_count}, ${cases}, ${test_lines}, ${doc_count},\n                                    ${doc_lines}, ${demo_count}, ${demo_lines}};\n} // namespace fakeos\n")
# Only touch the file when the numbers changed, so nothing rebuilds needlessly.
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL header)
    get_filename_component(dir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${OUT}" "${header}")
endif()
